{
  "name": "Broker",
  "properties": {
    "broker_license_document": {
      "type": "string"
    },
    "business_address": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "format": "email",
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "mc_number": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "rating": {
      "default": 5,
      "type": "number"
    },
    "review_count": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "w9_document": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "company",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}
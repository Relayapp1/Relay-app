{
  "name": "Driver",
  "properties": {
    "bio": {
      "type": "string"
    },
    "cancelled_trips": {
      "default": 0,
      "type": "number"
    },
    "completed_deliveries": {
      "default": 0,
      "type": "number"
    },
    "driving_history_consent": {
      "default": false,
      "type": "boolean"
    },
    "driving_history_report": {
      "type": "string"
    },
    "email": {
      "format": "email",
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "home_location": {
      "type": "string"
    },
    "operating_area": {
      "type": "string"
    },
    "license_back": {
      "type": "string"
    },
    "license_document": {
      "type": "string"
    },
    "license_expiration": {
      "format": "date",
      "type": "string"
    },
    "license_front": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_state": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "preferred_rate": {
      "type": "number"
    },
    "rating": {
      "default": 5,
      "type": "number"
    },
    "response_rate": {
      "default": 100,
      "type": "number"
    },
    "on_time_percentage": {
      "default": 100,
      "type": "number"
    },
    "review_count": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "total_expenses": {
      "default": 0,
      "type": "number"
    },
    "total_hours_worked": {
      "default": 0,
      "type": "number"
    },
    "vehicle_types": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "license_state",
    "license_expiration",
    "driving_history_consent"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}
{
  "name": "Message",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "broker_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "enum": [
        "broker",
        "driver"
      ],
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "broker_id",
    "driver_id",
    "sender_id",
    "sender_role",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
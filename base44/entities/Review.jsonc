{
  "name": "Review",
  "properties": {
    "comment": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "rating": {
      "maximum": 5,
      "minimum": 1,
      "type": "number"
    },
    "reviewee_id": {
      "type": "string"
    },
    "reviewee_role": {
      "enum": [
        "driver",
        "broker"
      ],
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_role": {
      "enum": [
        "driver",
        "broker"
      ],
      "type": "string"
    },
    "trip_id": {
      "type": "string"
    }
  },
  "required": [
    "deal_id",
    "trip_id",
    "reviewer_id",
    "reviewee_id",
    "rating"
  ],
  "rls": {
    "create": {
      "data.reviewer_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}
{
  "name": "Trip",
  "properties": {
    "accepted_rate": {
      "type": "number"
    },
    "bid_id": {
      "type": "string"
    },
    "broker_id": {
      "type": "string"
    },
    "broker_name": {
      "type": "string"
    },
    "cancelled_by": {
      "enum": [
        "driver",
        "broker"
      ],
      "type": "string"
    },
    "cancelled_at": {
      "format": "date-time",
      "type": "string"
    },
    "cancellation_fee_status": {
      "enum": [
        "not_applicable",
        "policy_pending",
        "assessed",
        "waived",
        "paid"
      ],
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_latitude": {
      "rls": {
        "write": {
          "$or": [
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "number"
    },
    "current_longitude": {
      "rls": {
        "write": {
          "$or": [
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "number"
    },
    "deal_id": {
      "type": "string"
    },
    "delivery_location": {
      "type": "string"
    },
    "estimated_hours": {
      "type": "number"
    },
    "return_plan": {
      "type": "string"
    },
    "job_notes": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "last_location_at": {
      "format": "date-time",
      "rls": {
        "write": {
          "$or": [
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "location_active": {
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "boolean"
    },
    "location_consent": {
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "boolean"
    },

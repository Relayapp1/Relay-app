      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "released",
        "refunded"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "funded_amount": {
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },

        "write": {
          "$or": [
            {
              "data.broker_id": "{{user.id}}"
            },
            {
              "data.driver_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "pickup_location": {
      "type": "string"
    },
    "pickup_date": {
      "format": "date",
      "type": "string"
    },
    "pickup_time": {

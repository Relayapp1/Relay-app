{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "driver",
        "broker"
      ],
      "type": "string"
    },
    "balance": {
      "default": 0,
      "type": "number"
    },
    "pending_deposits": {
      "default": 0,
      "type": "number"
    },
    "pending_withdrawals": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
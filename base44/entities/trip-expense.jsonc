{
  "name": "TripExpense",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "broker_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Gas",
        "Tolls",
        "Parking",
        "Food",
        "Other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "receipt_document": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "trip_id",
    "deal_id",
    "driver_id",
    "broker_id",
    "category",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}